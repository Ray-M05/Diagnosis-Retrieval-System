# SRI-DX Environment Variables

# OpenSearch Configuration
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_DOCS_INDEX=clinical_docs_v1
OPENSEARCH_CHUNKS_INDEX=clinical_chunks_v1
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ComplexPass123!

# Search APIs (if applicable)
# SERPER_API_KEY=your_key_here

# UMLS REST API - obtener en: https://uts.nlm.nih.gov/uts/signup-login
# Requerida para normalizacion de nombres de enfermedades via SNOMED CT / MeSH
UMLS_API_KEY=your_umls_api_key_here

# Model paths or names
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage paths
DATA_DIR=./data
INDEX_PATH=./data/artifacts/index.bin

# Application Settings
APP_NAME=SRI-DX
APP_VERSION=0.1.0
DEBUG=true

# Infrastructure
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ComplexPass123!

# RAG / Ollama (local LLM — requires Ollama running)
SRI_RAG_MODEL=llama3.1:8b-instruct
SRI_OLLAMA_HOST=http://localhost:11434

# FastAPI server
SRI_API_HOST=127.0.0.1
SRI_API_PORT=8000
SRI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite — set in frontend/.env.development)
# VITE_API_BASE=http://localhost:8000
